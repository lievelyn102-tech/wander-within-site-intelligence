# GEMINI_API_KEY: Primary Gemini AI API key injected by platform.
GEMINI_API_KEY=""

# USER_GEMINI_KEY: Fallback user-provided Gemini API key if GEMINI_API_KEY is unset or encounters authorization issues.
USER_GEMINI_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for Blogger API read-only access.
# Configure at Google Cloud Console Credentials -> OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Google OAuth 2.0 Client Secret for server-side token exchange.
GOOGLE_CLIENT_SECRET=""

# SESSION_SECRET: Secret key used to sign session cookies for isolated user authentication.
SESSION_SECRET="generate-a-strong-random-32-char-secret-here"

